<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="CurrencyExchange">
        <createTable tableName="CURRENCIES">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CURRENCIES"/>
            </column>
            <column name="CODE" type="VARCHAR(255)"/>
            <column name="FULL_NAME" type="VARCHAR(255)"/>
            <column name="SIGN" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="CurrencyExchange">
        <createTable tableName="EXCHANGE_RATES">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EXCHANGE_RATES"/>
            </column>
            <column name="BASE_CURRENCY_ID_ID" type="UUID"/>
            <column name="TARGET_CURRENCY_ID_ID" type="UUID"/>
            <column name="RATE" type="INT"/>
            <column name="CREATE_DATE" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="CurrencyExchange">
        <createIndex indexName="IDX_EXCHANGE_RATES_TARGET_CURRENCY_ID" tableName="EXCHANGE_RATES">
            <column name="TARGET_CURRENCY_ID_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="TARGET_CURRENCY_ID_ID" baseTableName="EXCHANGE_RATES"
                                 constraintName="FK_EXCHANGE_RATES_ON_TARGET_CURRENCY_ID" referencedColumnNames="ID"
                                 referencedTableName="CURRENCIES"/>
    </changeSet>
    <changeSet id="4" author="CurrencyExchange">
        <addForeignKeyConstraint baseColumnNames="BASE_CURRENCY_ID_ID" baseTableName="EXCHANGE_RATES"
                                 constraintName="FK_EXCHANGE_RATES_ON_BASE_CURRENCY_ID" referencedColumnNames="ID"
                                 referencedTableName="CURRENCIES"/>
    </changeSet>
</databaseChangeLog>