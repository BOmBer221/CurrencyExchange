<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://currenciesListView.title"
      focusComponent="currenciesesDataGrid">
    <data>
        <collection id="currenciesesDc"
                    class="com.company.currencyexchange.entity.Currencies">
            <fetchPlan extends="_base"/>
            <loader id="currenciesesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Currencies e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="currenciesesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="currenciesesDataGrid.createAction"/>
            <button id="editButton" action="currenciesesDataGrid.editAction"/>
            <button id="removeButton" action="currenciesesDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="currenciesesDl"/>
        </hbox>
        <dataGrid id="currenciesesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="currenciesesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="code"/>
                <column property="fullName"/>
                <column property="sign"/>
                <column property="country"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
