<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://exchangeRatesDetailView.title"
      focusComponent="form">
    <data>
        <instance id="exchangeRatesDc"
                  class="com.company.currencyexchange.entity.ExchangeRates">
            <fetchPlan extends="_base">
                <property name="baseCurrencyId" fetchPlan="_base"/>
                <property name="targetCurrencyId" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="exchangeRatesDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="exchangeRatesDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="baseCurrencyIdField" property="baseCurrencyId">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="targetCurrencyIdField" property="targetCurrencyId">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textField id="rateField" property="rate"/>
            <dateTimePicker id="createDateField" property="createDate"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
