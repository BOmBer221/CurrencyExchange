<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="CurrencyExchange">
        <createTable tableName="EXCHANGE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EXCHANGE"/>
            </column>
            <column name="FROM_CURRENCY_ID" type="UUID"/>
            <column name="TO_CURRENCY_ID" type="UUID"/>
            <column name="AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="RATE" type="DECIMAL(19, 2)"/>
            <column name="RESULT_" type="DECIMAL(19, 2)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="CurrencyExchange">
        <addForeignKeyConstraint baseColumnNames="FROM_CURRENCY_ID" baseTableName="EXCHANGE"
                                 constraintName="FK_EXCHANGE_ON_FROM_CURRENCY" referencedColumnNames="ID"
                                 referencedTableName="CURRENCIES"/>
    </changeSet>
    <changeSet id="3" author="CurrencyExchange">
        <addForeignKeyConstraint baseColumnNames="TO_CURRENCY_ID" baseTableName="EXCHANGE"
                                 constraintName="FK_EXCHANGE_ON_TO_CURRENCY" referencedColumnNames="ID"
                                 referencedTableName="CURRENCIES"/>
    </changeSet>
</databaseChangeLog>